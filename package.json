{
  "name": "cockpit",
  "private": true,
  "version": "1.3.0",
  "description": "Tableau de bord local pour un coffre Obsidian",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server/main.ts",
    "start": "node server/main.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "check": "npm run typecheck && npm run format:check && npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT"
}
